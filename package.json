{
  "name": "webextension",
  "version": "3.3.2",
  "description": "A WebExtension implementation of Alpheios",
  "main": "index.js",
  "scripts": {
    "build": "npm run build-prod && webpack --config webpack.config.safari.mjs --mode production && npm run update-styles",
    "build-prod": "npm run update-dist && npm run update-styles && npm run lint && npm run prod",
    "build-dev": "npm run update-dist && npm run update-styles && npm run dev",
    "verify:p0": "node ./scripts/verify_p0.mjs",
    "verify:worker-safe": "node ./scripts/verify_worker_safe.mjs",
    "build-safari": "npm run update-dist && npm run update-styles && npm run lint && webpack --config webpack.config.safari.mjs --mode production && npm run update-styles",
    "build-safari-dev": "npm run update-dist && npm run update-styles && webpack --config webpack.config.safari.mjs --mode development && npm run update-styles",
    "install:dev-safe": "npm install --legacy-peer-deps --ignore-scripts",
    "set-auth0": "node ./scripts/update_env.mjs",
    "update-styles": "node ./node_modules/alpheios-node-build/dist/files.mjs replace --s=../alpheios_alpheios-core/packages/components/dist/style --t=dist/style",
    "update-dist": "shx rm -rf ./dist && shx mkdir ./dist && shx cp -r ./src/manifest/* ./dist && shx cp -r ./src/icons ./dist && shx cp ./src/compatibility-fixes/compatibility-fixes.js ./dist && shx cp ./src/env/env-webext-template.js ./dist/env-webext.js && shx cp ./src/env/env-safari-app-ext-template.js ./src/lib/auth/env-safari-app-ext.js && shx mkdir ./dist/support && npm run webext-polyfill-update",
    "webext-polyfill-update": "node ./node_modules/alpheios-node-build/dist/files.mjs replace --s=./node_modules/webextension-polyfill/dist --t=dist/support/webextension-polyfill",
    "lint": "eslint --fix src/**/*.js",
    "prod": "webpack --config webpack.config.mjs --mode production",
    "dev": "webpack --config webpack.config.mjs --mode development",
    "test": "jest",
    "zip": "node ./build/zip.js",
    "conventional-commit": "npx git-cz",
    "version-set-major": "npm version major",
    "version-set-minor": "npm version minor",
    "version-set-patch": "npm version patch",
    "dist": "node ./node_modules/alpheios-node-build/dist/files.mjs copy --s=/dist --t=dist-temp  --clean && node ./node_modules/alpheios-node-build/dist/zip.mjs --s=/dist-temp --t=dist-zip --f=dist.zip && node ./node_modules/alpheios-node-build/dist/files.mjs clean --t=dist-temp",
    "github-build": "node ./github-build.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alpheios-project/webextension.git"
  },
  "author": "The Alpheios Project, Ltd.",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/alpheios-project/webextension/issues"
  },
  "homepage": "https://github.com/alpheios-project/webextension#readme",
  "devDependencies": {
    "@actions/core": "^1.2.4",
    "@auth0/auth0-spa-js": "1.8.1",
    "@babel/core": "^7.12.3",
    "@babel/eslint-parser": "^7.12.0",
    "@babel/preset-env": "^7.12.1",
    "alpheios-core": "git+https://github.com/alpheios-project/alpheios-core.git",
    "alpheios-node-build": "git+https://github.com/alpheios-project/node-build.git#semver:^3.5.1",
    "archiver": "^5.0.2",
    "babel-loader": "^8.1.0",
    "clean-webpack-plugin": "^3.0.0",
    "command-line-args": "^5.1.1",
    "crypto-browserify": "^3.12.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^7.12.1",
    "eslint-config-standard": "^16.0.1",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^4.2.1",
    "fs-extra": "^9.0.1",
    "git-branch": "^2.0.1",
    "jest": "^26.6.3",
    "jsonwebtoken": "^9.0.2",
    "shx": "^0.3.3",
    "stream-browserify": "^3.0.0",
    "uuid": "^8.3.1",
    "webextension-polyfill": "^0.6.0",
    "webpack": "^5.4.0",
    "webpack-cli": "^5.1.4",
    "wrap-range-text": "^1.0.1",
    "zip-a-folder": "0.0.12"
  },
  "engines": {
    "node": ">= 20.0.0",
    "npm": ">= 10.0.0"
  },
  "jest": {
    "verbose": true,
    "transform": {
      "^.+\\.jsx?$": "babel-jest"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/test/stubs/"
    ],
    "transformIgnorePatterns": [
      "!node_modules/alpheios-data-models/"
    ],
    "moduleFileExtensions": [
      "js"
    ]
  },
  "eslintConfig": {
    "extends": [
      "standard"
    ],
    "env": {
      "browser": true,
      "node": true,
      "es2020": true,
      "webextensions": true
    },
    "parserOptions": {
      "parser": "@babel/eslint-parser",
      "requireConfigFile": false,
      "sourceType": "module",
      "ecmaVersion": 2019,
      "allowImportExportEverywhere": true
    }
  },
  "eslintIgnore": [
    "**/dist",
    "**/support",
    "**/src/compatibility-fixes",
    "**/src/env"
  ],
  "dependencies": {
    "vue": "^3.5.33",
    "webextension-polyfill": "^0.6.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
