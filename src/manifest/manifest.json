{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "3.3.2",
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "16": "icons/alpheios_16.png",
    "32": "icons/alpheios_32.png",
    "128": "icons/alpheios_128.png"
  },
  "author": "The Alpheios Project, Ltd.",
  "homepage_url": "http://alpheios.net",
  "short_name": "Alpheios",
  "permissions": [
    "tabs",
    "activeTab",
    "contextMenus",
    "storage",
    "webNavigation",
    "identity",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_icon": "icons/alpheios_black_32.png",
    "default_title": "Activate Alpheios"
  },
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "alpheios@alpheios.net",
      "strict_min_version": "115.0"
    }
  },
  "web_accessible_resources": [{
    "resources": [
      "style/*",
      "styles/*",
      "icons/*",
      "support/*"
    ],
    "matches": [
      "http://*/*",
      "https://*/*"
    ]
  }]
}
